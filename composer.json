{
    "name": "shdigital/sh-speed-optimizer",
    "description": "Safety-first automatic performance optimization for WordPress.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "SH Digital",
            "homepage": "https://shdigital.ch/"
        }
    ],
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "squizlabs/php_codesniffer": "^3.10",
        "wp-coding-standards/wpcs": "^3.1",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0"
    },
    "autoload-dev": {
        "psr-4": {
            "SH\\SpeedOptimizer\\Tests\\": "tests/unit/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "find . -path ./vendor -prune -o -path ./tests/e2e/node_modules -prune -o -name '*.php' -print0 | xargs -0 -n1 -P4 php -l > /dev/null",
        "phpcs": "phpcs"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "platform": {
            "php": "8.1.0"
        }
    }
}
